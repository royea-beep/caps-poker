{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "NODE_ENV": "production" }
    },
    "production": {
      "ios": { "buildConfiguration": "Release", "autoIncrement": true }
    }
  },
  "submit": {
    "production": {
      "ios": { "appleId": "royearguan@gmail.com" }
    }
  }
}
