# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
# Probe bundle built by tests/celebration-gate-probe.mjs and tests/parity-3p-probe.mjs
# (EXPO_PUBLIC_CAPS_FIXTURE=1 export). A build artifact — never committed.
web-fixture-dist/
test-results/
# Renders + measurements written by tests/felt-compare.mjs and tests/felt-measure.mjs.
# Regenerated by one command, and the reviewed copies live in the published comparison,
# so the PNGs are output rather than source. A build artifact - never committed.
felt-compare/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
CLAUDE.md

.vercel

# Claude Code session data (may contain tokens)
.claude/settings.local.json

# code-review-graph knowledge graph (local only)
.code-review-graph/

# Skills (per-machine, not tracked in git)
.claude/skills/

# BackstopJS — only bitmaps_reference is committed (the baseline).
# Test renders, diffs, and HTML reports are CI artifacts, not source.
backstop_data/bitmaps_test/
backstop_data/html_report/
backstop_data/ci_report/

# axe-core / WCAG audit report — regenerated each CI run
tests/wcag-report.json
tests/animation-probe-result.json
tests/landing-probe-result.json
tests/confetti-probe-result.json

# GENERATED, NEVER COMMITTED — scripts/gen-edge-shared.mjs rebuilds this from the app source of
# record every deploy. A committed copy is the second source of truth arriving by the back door.
supabase/functions/_shared/

# Playwright QA artifacts - large binaries, regenerated per run
tests/screenshots/
