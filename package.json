{
  "name": "caps-poker",
  "version": "1.9.4",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate-icons": "node scripts/generate-icon.js",
    "ota": "NODE_OPTIONS='--max-old-space-size=8192' npx expo export --platform ios --platform android --output-dir /tmp/caps_ota --dump-assetmap --source-maps && NODE_OPTIONS='--max-old-space-size=8192' eas update --branch production --environment production --input-dir /tmp/caps_ota --skip-bundler",
    "postinstall": "echo 'postinstall: no patches needed'",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' jest --testPathIgnorePatterns='tests/visual' --testPathIgnorePatterns='.claude'",
    "qa:placement": "node scripts/qa-capture-placement.cjs",
    "visual-audit": "npx tsx tests/visual-audit.spec.ts",
    "visual-qa": "playwright test",
    "visual-qa:update": "playwright test --update-snapshots",
    "wcag:bootstrap": "node tests/bootstrap-storage-state.js",
    "wcag:audit": "node tests/wcag-audit.js",
    "backstop:reference": "backstop reference",
    "backstop:test": "backstop test",
    "backstop:approve": "backstop approve"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.99.1",
    "expo": "~55.0.15",
    "expo-application": "~55.0.14",
    "expo-asset": "~55.0.15",
    "expo-audio": "~55.0.13",
    "expo-camera": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "~55.0.27",
    "expo-device": "~55.0.15",
    "expo-file-system": "~55.0.16",
    "expo-haptics": "~55.0.14",
    "expo-insights": "~55.0.16",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.13",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.19",
    "expo-router": "~55.0.12",
    "expo-screen-orientation": "~55.0.13",
    "expo-sensors": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-store-review": "~55.0.13",
    "expo-updates": "~55.0.20",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-purchases": "^9.15.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/uuid": "^10.0.0",
    "backstopjs": "^6.3.25",
    "jest": "~29.7.0",
    "playwright": "^1.59.1",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket"
        ]
      }
    }
  },
  "private": true
}
