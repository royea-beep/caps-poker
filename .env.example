# Supabase credentials — get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp via Twilio (used in Supabase Edge Functions: whatsapp-bot-handler, crash-analyzer)
# Add these as Supabase secrets: supabase secrets set TWILIO_ACCOUNT_SID=xxx ...
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+14155238886

# WhatsApp (Meta Cloud API — alternative to Twilio)
WHATSAPP_VERIFY_TOKEN=caps-whatsapp-verify-2026
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Anthropic — Claude Haiku for bug report AI triage (OTA-safe, internal tester builds only)
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Expo push notifications
EXPO_PUBLIC_PROJECT_ID=

# Sentry — get DSN from https://sentry.io/settings/royea/projects/caps-poker/keys/
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
